<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Header — orange to signal urgency -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E65100"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️  Attendance Check"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perform the action below and respond"
            android:textColor="#FFCCBC"
            android:textSize="13sp"/>

    </LinearLayout>

    <!-- Action Instruction Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="24dp"
        android:gravity="center">

        <!-- Action Icon -->
        <TextView
            android:id="@+id/tvActionIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁"
            android:textSize="56sp"
            android:layout_marginBottom="8dp"/>

        <!-- Action Label -->
        <TextView
            android:id="@+id/tvActionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLINK"
            android:textColor="#FF6D00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Action Description -->
        <TextView
            android:id="@+id/tvActionDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blink your eyes clearly"
            android:textColor="#BDBDBD"
            android:textSize="14sp"/>

        <!-- Countdown Timer -->
        <TextView
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2:00"
            android:textColor="#FF6D00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#212121"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perform the action, then tap Respond"
            android:textColor="#EEEEEE"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Respond Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRespond"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Capture &amp; Respond"
            android:textSize="16sp"
            android:backgroundTint="#E65100"
            android:layout_marginBottom="8dp"/>

        <!-- Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            app:strokeColor="#FFFFFF"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- Result Message -->
        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>